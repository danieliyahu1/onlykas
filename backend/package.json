{
  "name": "@kaskama/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "start": "node dist/server.js",
    "db:reset": "tsx src/reset-db.ts",
    "test": "vitest run --globals",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:membership": "tsx src/verifier-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@kaskama/shared": "workspace:*",
    "@kluster/kaspa-wasm": "2.0.1",
    "@libsql/client": "^0.15.15",
    "@noble/hashes": "^2.0.0",
    "@smithy/node-http-handler": "^4.11.3",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "kaspa-wasm": "0.13.0",
    "prom-client": "15.1.3",
    "sharp": "^0.34.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "ffprobe-static": "^3.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
