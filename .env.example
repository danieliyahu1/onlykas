# Application
NODE_ENV=development
PORT=3000
METRICS_PORT=9090
PUBLIC_ORIGIN=http://localhost:5173

# Development database: Turso/libSQL
DATABASE_URL=libsql://kaskama-development-danieliyahu1.aws-eu-west-1.turso.io
DATABASE_AUTH_TOKEN=

# Development media storage: Cloudflare R2
R2_ENDPOINT=https://c0d977ba2937e996cc8e9b8cbacf075d.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=kaskama-development
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
# KASPA_NETWORK selects mainnet or testnet-10. The server derives address
# validation, the platform fee wallet, the default node URL, contract address
# derivation, transaction mass, and wRPC submission from it. The browser reads
# it from /api/config. Development uses testnet-10; production uses mainnet.
KASPA_NETWORK=testnet-10
# KASPA_NODE_URL is optional; the selected network supplies the default node.
# KASPA_NODE_URL=https://api-tn10.kaspa.org

# Platform fee wallet: local development runs on testnet-10, so it sets only
# PLATFORM_FEE_ADDRESS_TESTNET_10. Production sets PLATFORM_FEE_ADDRESS_MAINNET
# from OCI Vault. Only the address matching KASPA_NETWORK is read, and it must
# be a single-key P2PK address on that network.
PLATFORM_FEE_ADDRESS_TESTNET_10=kaspatest:qpd82aj5unvrcj59ygscnmv9g0lryl3j5lp0dqquufqae382lh7lyxkh30lue

# Anonymous feedback delivery (Telegram): optional at runtime.
# When these are unset the app still accepts feedback and queues it in the
# spill file until a bot is configured. `FEEDBACK_TELEGRAM_SEND_URL` is optional
# and overrides the default https://api.telegram.org/bot<token>/sendMessage.
TELEGRAM_FEEDBACK_BOT_TOKEN=
TELEGRAM_FEEDBACK_CHAT_ID=
# FEEDBACK_TELEGRAM_SEND_URL=
# FEEDBACK_SPILL_PATH=/tmp/feedback-spill.json
