# Application
NODE_ENV=development
PORT=3000
METRICS_PORT=9090
PUBLIC_ORIGIN=http://localhost:5173

# Development database: Turso/libSQL
DATABASE_URL=libsql://onlykas-danieliyahu1.aws-eu-west-1.turso.io
DATABASE_AUTH_TOKEN=

# Development media storage: Cloudflare R2
R2_ENDPOINT=https://c0d977ba2937e996cc8e9b8cbacf075d.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=onlykas-development
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
KASPA_NODE_URL=https://api-tn10.kaspa.org

# Background media verification worker
MEDIA_JOB_INTERVAL_MS=5000
MEDIA_JOB_STALE_MS=300000

# Anonymous feedback delivery (Telegram): optional at runtime.
# When these are unset the app still accepts feedback and queues it in the
# spill file until a bot is configured. `FEEDBACK_TELEGRAM_SEND_URL` is optional
# and overrides the default https://api.telegram.org/bot<token>/sendMessage.
TELEGRAM_FEEDBACK_BOT_TOKEN=
TELEGRAM_FEEDBACK_CHAT_ID=
# FEEDBACK_TELEGRAM_SEND_URL=
# FEEDBACK_SPILL_PATH=/tmp/feedback-spill.json
